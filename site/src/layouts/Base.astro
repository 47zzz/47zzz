---
import '../styles/global.css';
import { profile } from '../data/profile';
import { ui } from '../data/ui';
import { route, withBase, type Lang } from '../lib/url';
interface Props { lang: Lang; page?: string; title?: string; description?: string; noindex?: boolean }
const { lang, page = '', title, description = profile.intro[lang], noindex = false } = Astro.props;
const t = ui[lang];
const other = lang === 'en' ? 'zh-tw' : 'en';
const canonical = new URL(route(lang, page), Astro.site);
const navigation = ['', 'publications', 'experience', 'about'] as const;
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-Hant'}>
 <head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} — ${profile.name}` : `${profile.name} (${profile.alias}) — ${profile.role.en}`}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={new URL(route('en', page), Astro.site)} />
  <link rel="alternate" hreflang="zh-Hant" href={new URL(route('zh-tw', page), Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(route('en', page), Astro.site)} />
  <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  <link rel="alternate" type="application/rss+xml" title={`${profile.name} · ${t.research}`} href={withBase('rss.xml')} />
  <meta property="og:type" content="website" /><meta property="og:title" content={title ? `${title} — ${profile.name}` : profile.name} />
  <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
   try { const saved = localStorage.getItem('theme'); document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch { document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
  </script>
 </head>
 <body>
  <a class="skip" href="#main">{t.skip}</a>
  <div class="site-shell">
   <header class="header">
    <a class="wordmark" href={route(lang)} aria-label={`${profile.name} — ${t.home}`}><span class="monogram">{profile.initials}<span class="monogram-dot">.</span></span><span class="wordmark-name">{profile.name}</span></a>
    <nav aria-label={lang === 'en' ? 'Main navigation' : '主要導覽'}>
     {navigation.map(item => <a href={route(lang, item)} aria-current={page === item ? 'page' : undefined}>{t[item || 'home']}</a>)}
    </nav>
    <div class="utilities">
     <a class="language" href={route(other, page)} lang={other === 'en' ? 'en' : 'zh-Hant'} aria-label={other === 'en' ? 'View in English' : '切換至繁體中文'}>{other === 'en' ? 'EN' : '繁中'}</a>
     <span class="utility-rule" aria-hidden="true"></span>
     <button class="theme-toggle" aria-label={t.theme} data-light-label={t.themeLight} data-dark-label={t.themeDark}>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13.2A8.7 8.7 0 0 1 10.8 3.5 8.7 8.7 0 1 0 20.5 13.2Z" /></svg>
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
     </button>
    </div>
   </header>
   <main id="main"><slot /></main>
   <footer class="footer"><div><a class="footer-name" href={route(lang)}>{profile.name}</a><span>{t.footer}</span></div><div class="footer-links"><a href={`mailto:${profile.email}`}>Email ↗</a><a href={profile.github}>GitHub ↗</a><a href={profile.orcid}>ORCID ↗</a></div><span class="footer-location">{profile.location[lang]}</span></footer>
  </div>
  <script>
   const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
   const updateLabel = () => { if(toggle) toggle.setAttribute('aria-label', (document.documentElement.dataset.theme === 'dark' ? toggle.dataset.lightLabel : toggle.dataset.darkLabel) || 'Switch color theme'); };
   updateLabel();
   toggle?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('theme', next); } catch {} updateLabel(); });
  </script>
 </body>
</html>
