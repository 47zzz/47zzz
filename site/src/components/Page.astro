---
import Base from '../layouts/Base.astro';
import PublicationList from './PublicationList.astro';
import ResearchCards from './ResearchCards.astro';
import Education from './Education.astro';
import { profile } from '../data/profile';
import { publications } from '../data/publications';
import { research, teaching, awards, industry, skills, languages } from '../data/experience';
import { ui } from '../data/ui';
import { route, type Lang } from '../lib/url';
const { lang, page = '' } = Astro.props as {lang: Lang; page?: '' | 'publications' | 'experience' | 'about'};
const t = ui[lang];
---
<Base lang={lang} page={page} title={page ? t[page] : undefined}>
 {page === '' ? <>
  <section class="hero">
   <div class="hero-main"><p class="eyebrow hero-eyebrow"><span class="status-dot" aria-hidden="true"></span>{t.research} / {profile.location[lang]}</p><h1>{profile.name}<span class="alias">{profile.alias}</span></h1><p class="hero-intro">{profile.intro[lang]}</p><div class="hero-actions"><a class="button" href={route(lang, 'publications')}>{t.explore}<span aria-hidden="true">↗</span></a></div></div>
   <aside class="identity"><div class="identity-mark" aria-hidden="true"><svg viewBox="0 0 120 64" fill="none"><path d="M4 32h112"/><g>{[10,20,36,54,40,24,46,60,38,18,8].map((h,i)=><line x1={10+i*10} x2={10+i*10} y1={32-h/2} y2={32+h/2}/>)}</g></svg></div><p class="eyebrow">{profile.role[lang]}</p><a class="lab-name" href={profile.labUrl}>{profile.lab}<span aria-hidden="true"> ↗</span></a><p class="identity-university">{profile.institution[lang]}</p><p class="advisor">{t.advisor}: <a href={profile.advisorUrl}>Prof. {profile.advisor}</a></p><div class="identity-links"><a href={`mailto:${profile.email}`}>Email ↗</a><a href={profile.github}>GitHub ↗</a><a href={profile.orcid}>ORCID ↗</a></div></aside>
  </section>
  <div class="interests-strip"><span class="eyebrow">{t.focus}</span><div>{profile.interests[lang].map((interest,i)=><><span>{interest}</span>{i<2 && <span class="separator" aria-hidden="true">/</span>}</>)}</div></div>
  <section class="section selected-section"><div class="section-heading"><div><span class="section-number">01</span><h2>{t.selected}</h2></div><a class="text-link" href={route(lang,'publications')}>{t.allPapers}<span aria-hidden="true">↗</span></a></div><PublicationList papers={publications.filter(p=>p.selected)} lang={lang}/></section>
  <section class="section"><div class="section-heading"><div><span class="section-number">02</span><h2>{t.research}</h2></div></div><ResearchCards lang={lang}/></section>
  <section class="contact-band"><div><span class="eyebrow">{profile.location[lang]}</span><h2>{t.contact}.</h2></div><a href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a></section>
 </> : page === 'publications' ? <>
  <div class="page-heading"><p class="eyebrow">{t.research}</p><h1>{t.pubTitle}</h1><p>{t.pubLead}</p></div>
  <section class="section compact"><div class="section-heading"><div><span class="section-number">01</span><h2>{t.reviewed}</h2></div></div><PublicationList papers={publications.filter(p=>p.kind==='reviewed')} lang={lang}/></section>
  <section class="section"><div class="section-heading"><div><span class="section-number">02</span><h2>{t.preprints}</h2></div></div><PublicationList papers={publications.filter(p=>p.kind==='preprint')} lang={lang}/></section>
 </> : page === 'experience' ? <>
  <div class="page-heading"><p class="eyebrow">{profile.name}</p><h1>{t.expTitle}</h1><p>{t.expLead}</p></div>
  <section class="timeline-section"><h2>{t.research}</h2>{research.map(item=><div class="timeline-row"><div class="timeline-date">{item.dates}</div><div><h3>{item.title[lang]}</h3><p class="org">{item.org[lang]}</p><p class="advisor">{t.advisor}: Prof. {item.advisor}</p><p>{item.description[lang]}</p></div></div>)}</section>
  <section class="timeline-section"><h2>{t.teaching}</h2>{teaching.map(item=><div class="timeline-row"><div class="timeline-date">{item.dates}</div><div><h3>{item.title[lang]}</h3><p class="org">{item.org[lang]}</p><p>{item.description[lang]}</p></div></div>)}</section>
  <section class="timeline-section"><h2>{t.education}</h2><Education lang={lang}/></section>
  <section class="timeline-section"><h2>{t.awards}</h2>{awards.map(item=><div class="timeline-row"><div class="timeline-date">{item.year}</div><div><h3>{item.href ? <a href={item.href}>{item.title[lang]} ↗</a> : item.title[lang]}</h3><p>{item.description[lang]}</p></div></div>)}</section>
  <section class="timeline-section"><h2>{t.industry}</h2><div class="timeline-row"><div class="timeline-date">{industry.dates}</div><div><h3>{industry.title[lang]}</h3><p class="org">{industry.org}</p><p>{industry.description[lang]}</p></div></div></section>
 </> : page === 'about' ? <>
  <div class="page-heading"><p class="eyebrow">{t.about}</p><h1>{t.bioTitle}</h1><p>{t.aboutLead}</p></div>
  <section class="about-grid"><div class="prose"><p class="lead">{profile.bio[lang]}</p><p>{profile.perspective[lang]}</p><div class="about-contact"><a class="text-link" href={`mailto:${profile.email}`}>{profile.email} ↗</a><a class="text-link" href={profile.orcid}>ORCID ↗</a></div></div><aside class="about-aside"><span class="eyebrow">{t.focus}</span><ul>{profile.interests[lang].map(item=><li>{item}</li>)}</ul><a class="text-link" href={profile.labUrl}>{profile.lab} ↗</a></aside></section>
  <section class="timeline-section"><h2>{t.education}</h2><Education lang={lang}/></section>
  <section class="timeline-section"><h2>{t.skills}</h2><div class="skills">{skills.map(skill=><span>{skill}</span>)}</div><p class="muted">{languages[lang]}</p></section>
 </> : null}
</Base>
